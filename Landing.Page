<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Luminary — Design Studio</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream: #f5f0e8;
      --ink: #1a1610;
      --rust: #c1440e;
      --gold: #d4a853;
      --muted: #7a7060;
      --card-bg: #ffffff;
      --border: #e0d8cc;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background-color: var(--cream);
      color: var(--ink);
      overflow-x: hidden;
    }

    /* ── NOISE TEXTURE OVERLAY ── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 9999;
      opacity: 0.6;
    }

    /* ── NAVBAR ── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.4rem 4rem;
      background: rgba(245,240,232,0.85);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }

    .nav-logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      font-weight: 900;
      letter-spacing: -0.02em;
      color: var(--ink);
      text-decoration: none;
    }
    .nav-logo span { color: var(--rust); }

    .nav-links {
      display: flex;
      gap: 2.5rem;
      list-style: none;
    }
    .nav-links a {
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--rust); }

    .nav-cta {
      background: var(--ink);
      color: var(--cream) !important;
      padding: 0.55rem 1.4rem;
      border-radius: 2px;
    }
    .nav-cta:hover { background: var(--rust); color: var(--cream) !important; }

    /* ── HERO ── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      padding-top: 80px;
    }

    .hero-left {
      padding: 6rem 4rem 4rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--rust);
      margin-bottom: 1.5rem;
    }
    .hero-eyebrow::before {
      content: '';
      width: 2rem;
      height: 1px;
      background: var(--rust);
    }

    .hero-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(3rem, 5vw, 5.5rem);
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -0.03em;
      margin-bottom: 1.5rem;
      animation: fadeUp 0.9s ease both;
    }
    .hero-title em {
      font-style: italic;
      color: var(--rust);
    }

    .hero-desc {
      font-size: 1.05rem;
      font-weight: 300;
      line-height: 1.8;
      color: var(--muted);
      max-width: 420px;
      margin-bottom: 2.5rem;
      animation: fadeUp 0.9s 0.15s ease both;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      animation: fadeUp 0.9s 0.3s ease both;
    }

    .btn-primary {
      background: var(--rust);
      color: white;
      padding: 0.85rem 2rem;
      border: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: background 0.2s, transform 0.2s;
    }
    .btn-primary:hover { background: #a53609; transform: translateY(-2px); }

    .btn-secondary {
      background: transparent;
      color: var(--ink);
      padding: 0.85rem 2rem;
      border: 1.5px solid var(--ink);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: all 0.2s;
    }
    .btn-secondary:hover { background: var(--ink); color: var(--cream); }

    .hero-stats {
      display: flex;
      gap: 3rem;
      margin-top: 4rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--border);
      animation: fadeUp 0.9s 0.45s ease both;
    }
    .stat-number {
      font-family: 'Playfair Display', serif;
      font-size: 2.2rem;
      font-weight: 700;
      line-height: 1;
      color: var(--ink);
    }
    .stat-label {
      font-size: 0.78rem;
      font-weight: 400;
      color: var(--muted);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-top: 0.3rem;
    }

    /* HERO RIGHT — mosaic */
    .hero-right {
      position: relative;
      background: var(--ink);
      overflow: hidden;
    }
    .hero-right::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(193,68,14,0.3) 0%, transparent 60%);
    }

    .mosaic {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(3, 1fr);
      gap: 3px;
      height: 100%;
    }
    .mosaic-cell {
      background: #2a2218;
      position: relative;
      overflow: hidden;
    }
    .mosaic-cell:nth-child(1) { grid-row: span 2; background: #1f1b14; }
    .mosaic-cell:nth-child(3) { background: var(--rust); opacity: 0.85; }

    .mosaic-label {
      position: absolute;
      bottom: 1rem;
      left: 1rem;
      font-size: 0.7rem;
      color: rgba(255,255,255,0.5);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* ── MARQUEE ── */
    .marquee-wrap {
      background: var(--ink);
      padding: 1rem 0;
      overflow: hidden;
      border-top: 1px solid #2a2218;
      border-bottom: 1px solid #2a2218;
    }
    .marquee-track {
      display: flex;
      gap: 3rem;
      animation: marquee 20s linear infinite;
      width: max-content;
    }
    .marquee-item {
      font-family: 'Playfair Display', serif;
      font-size: 1rem;
      font-style: italic;
      color: rgba(245,240,232,0.4);
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .marquee-item::after {
      content: '✦';
      color: var(--rust);
      font-style: normal;
    }

    /* ── SERVICES ── */
    .section { padding: 7rem 4rem; }
    .section-tag {
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--rust);
      margin-bottom: 1rem;
    }
    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 3.5vw, 3rem);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }
    .section-sub {
      font-size: 1rem;
      color: var(--muted);
      font-weight: 300;
      max-width: 480px;
      line-height: 1.7;
      margin-bottom: 4rem;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5px;
      background: var(--border);
      border: 1.5px solid var(--border);
    }
    .service-card {
      background: var(--cream);
      padding: 2.5rem;
      position: relative;
      overflow: hidden;
      transition: background 0.3s;
      cursor: default;
    }
    .service-card:hover { background: var(--ink); }
    .service-card:hover .service-title,
    .service-card:hover .service-desc,
    .service-card:hover .service-num { color: var(--cream); }
    .service-card:hover .service-icon { background: var(--rust); }

    .service-num {
      font-family: 'Playfair Display', serif;
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 1.5rem;
      transition: color 0.3s;
    }
    .service-icon {
      width: 48px;
      height: 48px;
      background: var(--ink);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.3s;
    }
    .service-icon svg { width: 22px; height: 22px; stroke: var(--cream); fill: none; stroke-width: 1.5; }
    .service-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
      transition: color 0.3s;
    }
    .service-desc {
      font-size: 0.88rem;
      line-height: 1.7;
      color: var(--muted);
      transition: color 0.3s;
    }

    /* ── FEATURED WORK ── */
    .work-section { background: var(--ink); padding: 7rem 4rem; }
    .work-section .section-title { color: var(--cream); }
    .work-section .section-tag { color: var(--gold); }
    .work-section .section-sub { color: rgba(245,240,232,0.5); }

    .work-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 1rem;
    }
    .work-card {
      background: #2a2218;
      position: relative;
      overflow: hidden;
      cursor: pointer;
    }
    .work-card:first-child { grid-row: span 2; min-height: 520px; }
    .work-card:not(:first-child) { min-height: 250px; }

    .work-card-bg {
      position: absolute;
      inset: 0;
      background: linear-gradient(45deg, #2a2218 0%, #3d3020 100%);
      transition: transform 0.5s ease;
    }
    .work-card:hover .work-card-bg { transform: scale(1.03); }

    .work-card-stripe {
      position: absolute;
      top: 0; left: 0;
      width: 4px;
      height: 100%;
    }
    .stripe-rust { background: var(--rust); }
    .stripe-gold { background: var(--gold); }
    .stripe-cream { background: var(--cream); }

    .work-card-info {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      padding: 1.5rem;
      background: linear-gradient(transparent, rgba(0,0,0,0.7));
    }
    .work-tag {
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.4rem;
    }
    .work-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.15rem;
      color: white;
    }

    /* ── PROCESS ── */
    .process-section { padding: 7rem 4rem; background: #f0ebe0; }
    .process-steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      margin-top: 3rem;
    }
    .process-step {
      position: relative;
      padding-top: 1rem;
    }
    .step-line {
      height: 2px;
      background: var(--border);
      margin-bottom: 2rem;
      position: relative;
    }
    .step-dot {
      width: 10px;
      height: 10px;
      background: var(--rust);
      border-radius: 50%;
      position: absolute;
      top: -4px;
      left: 0;
    }
    .step-num {
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      font-weight: 900;
      color: var(--border);
      line-height: 1;
      margin-bottom: 1rem;
    }
    .step-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 0.6rem;
    }
    .step-desc {
      font-size: 0.85rem;
      color: var(--muted);
      line-height: 1.7;
    }

    /* ── TESTIMONIAL ── */
    .testimonial-section {
      padding: 7rem 4rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
      align-items: center;
    }
    .testimonial-quote {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.4rem, 2.5vw, 2rem);
      font-weight: 400;
      font-style: italic;
      line-height: 1.5;
      color: var(--ink);
    }
    .testimonial-quote::before {
      content: '"';
      font-size: 5rem;
      color: var(--rust);
      line-height: 0;
      vertical-align: -2rem;
      margin-right: 0.2rem;
    }
    .testimonial-author {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 2rem;
    }
    .author-avatar {
      width: 48px; height: 48px;
      background: var(--ink);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--cream);
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
    }
    .author-name { font-weight: 500; font-size: 0.95rem; }
    .author-role { font-size: 0.8rem; color: var(--muted); }

    .testimonial-right { display: flex; flex-direction: column; gap: 1.5rem; }
    .mini-card {
      background: var(--cream);
      border: 1px solid var(--border);
      padding: 1.5rem;
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      transition: border-color 0.2s, transform 0.2s;
    }
    .mini-card:hover { border-color: var(--rust); transform: translateX(4px); }
    .mini-icon {
      width: 36px; height: 36px;
      background: var(--rust);
      flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .mini-icon svg { width: 16px; height: 16px; stroke: white; fill: none; stroke-width: 2; }
    .mini-title { font-weight: 500; font-size: 0.9rem; margin-bottom: 0.25rem; }
    .mini-text { font-size: 0.82rem; color: var(--muted); line-height: 1.5; }

    /* ── CTA BANNER ── */
    .cta-banner {
      background: var(--rust);
      padding: 6rem 4rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .cta-banner h2 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 4vw, 3.5rem);
      font-weight: 900;
      color: white;
      line-height: 1.1;
      max-width: 500px;
    }
    .cta-banner h2 em { font-style: italic; color: var(--gold); }
    .btn-white {
      background: white;
      color: var(--rust);
      padding: 1rem 2.5rem;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.95rem;
      font-weight: 500;
      border: none;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: all 0.2s;
      flex-shrink: 0;
    }
    .btn-white:hover { background: var(--ink); color: white; }

    /* ── FOOTER ── */
    footer {
      background: var(--ink);
      color: var(--cream);
      padding: 5rem 4rem 2.5rem;
    }
    .footer-top {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 4rem;
      padding-bottom: 3rem;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      margin-bottom: 2.5rem;
    }
    .footer-brand p {
      font-size: 0.88rem;
      color: rgba(245,240,232,0.45);
      line-height: 1.8;
      margin-top: 1rem;
      max-width: 260px;
    }
    .footer-logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.6rem;
      font-weight: 900;
    }
    .footer-logo span { color: var(--rust); }
    .footer-col h4 {
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(245,240,232,0.4);
      margin-bottom: 1.2rem;
    }
    .footer-col ul { list-style: none; }
    .footer-col ul li { margin-bottom: 0.7rem; }
    .footer-col ul a {
      text-decoration: none;
      font-size: 0.88rem;
      color: rgba(245,240,232,0.65);
      transition: color 0.2s;
    }
    .footer-col ul a:hover { color: var(--gold); }
    .footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .footer-bottom p { font-size: 0.8rem; color: rgba(245,240,232,0.3); }
    .social-links { display: flex; gap: 1rem; }
    .social-links a {
      width: 34px; height: 34px;
      border: 1px solid rgba(255,255,255,0.15);
      display: flex; align-items: center; justify-content: center;
      text-decoration: none;
      font-size: 0.75rem;
      color: rgba(245,240,232,0.5);
      transition: all 0.2s;
    }
    .social-links a:hover { border-color: var(--rust); color: var(--rust); }

    /* ── ANIMATIONS ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      nav { padding: 1.2rem 1.5rem; }
      .nav-links { display: none; }
      .hero { grid-template-columns: 1fr; }
      .hero-right { min-height: 300px; }
      .hero-left { padding: 3rem 1.5rem; }
      .section { padding: 4rem 1.5rem; }
      .services-grid { grid-template-columns: 1fr; }
      .work-grid { grid-template-columns: 1fr; }
      .work-card:first-child { grid-row: span 1; }
      .process-steps { grid-template-columns: 1fr 1fr; }
      .testimonial-section { grid-template-columns: 1fr; gap: 3rem; padding: 4rem 1.5rem; }
      .cta-banner { padding: 4rem 1.5rem; }
      .footer-top { grid-template-columns: 1fr 1fr; gap: 2rem; padding: 3rem 1.5rem; }
      footer { padding: 3rem 1.5rem 2rem; }
      .work-section { padding: 4rem 1.5rem; }
      .process-section { padding: 4rem 1.5rem; }
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav>
    <a href="#" class="nav-logo">Lumin<span>.</span></a>
    <ul class="nav-links">
      <li><a href="#services">Services</a></li>
      <li><a href="#work">Work</a></li>
      <li><a href="#process">Process</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#contact" class="nav-cta">Start a Project</a></li>
    </ul>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-left">
      <div class="hero-eyebrow">Creative Design Studio</div>
      <h1 class="hero-title">
        We craft<br><em>bold</em> digital<br>experiences
      </h1>
      <p class="hero-desc">
        Luminary is a design studio that turns ambitious ideas into 
        remarkable digital products. Strategy, design, and development — 
        all under one roof.
      </p>
      <div class="hero-actions">
        <a href="#work" class="btn-primary">View Our Work</a>
        <a href="#services" class="btn-secondary">What We Do</a>
      </div>
      <div class="hero-stats">
        <div>
          <div class="stat-number">140+</div>
          <div class="stat-label">Projects Delivered</div>
        </div>
        <div>
          <div class="stat-number">12yr</div>
          <div class="stat-label">Studio Experience</div>
        </div>
        <div>
          <div class="stat-number">98%</div>
          <div class="stat-label">Client Satisfaction</div>
        </div>
      </div>
    </div>
    <div class="hero-right">
      <div class="mosaic">
        <div class="mosaic-cell">
          <div class="mosaic-label">Branding</div>
        </div>
        <div class="mosaic-cell">
          <div class="mosaic-label">UI Design</div>
        </div>
        <div class="mosaic-cell"></div>
        <div class="mosaic-cell">
          <div class="mosaic-label">Strategy</div>
        </div>
        <div class="mosaic-cell">
          <div class="mosaic-label">Motion</div>
        </div>
        <div class="mosaic-cell">
          <div class="mosaic-label">Dev</div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee-wrap">
    <div class="marquee-track">
      <span class="marquee-item">Brand Identity</span>
      <span class="marquee-item">Web Design</span>
      <span class="marquee-item">Motion Graphics</span>
      <span class="marquee-item">UX Strategy</span>
      <span class="marquee-item">Product Design</span>
      <span class="marquee-item">Visual Systems</span>
      <span class="marquee-item">Brand Identity</span>
      <span class="marquee-item">Web Design</span>
      <span class="marquee-item">Motion Graphics</span>
      <span class="marquee-item">UX Strategy</span>
      <span class="marquee-item">Product Design</span>
      <span class="marquee-item">Visual Systems</span>
    </div>
  </div>

  <!-- SERVICES -->
  <section class="section" id="services">
    <div class="section-tag">What We Offer</div>
    <h2 class="section-title">Studio Services</h2>
    <p class="section-sub">
      From initial concept to final launch, we cover every dimension 
      of crafting a world-class digital presence.
    </p>

    <div class="services-grid">
      <div class="service-card">
